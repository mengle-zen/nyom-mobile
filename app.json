{
  "expo": {
    "name": "뇸",
    "slug": "nyom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nyom",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "nyom.mengle.zen",
      "buildNumber": "8",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "끼니 사진을 찍어 그룹에 공유하기 위해 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "갤러리에서 끼니 사진을 골라 올리기 위해 사진 보관함에 접근합니다.",
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF7A2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.nyom.mobile",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF7A2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "갤러리에서 끼니 사진을 고르기 위해 접근합니다.",
          "cameraPermission": "끼니 사진을 찍기 위해 카메라를 사용합니다."
        }
      ],
      "expo-notifications",
      "expo-font",
      "./plugins/with-serial-framework-signing",
      "./plugins/with-scene-lifecycle",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa20770e-9473-40e3-9790-15e8b72dfbb2"
      }
    },
    "owner": "hyorish03"
  }
}
